<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScooterScribe | Roller-hibajegyek" Width="1140" Height="790"
        MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="#F3F6F7" Foreground="#142D35"
        FontFamily="Inter, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#142D35" />
        <SolidColorBrush x:Key="Muted" Color="#52676E" />
        <SolidColorBrush x:Key="Line" Color="#CEDBDD" />
        <SolidColorBrush x:Key="Teal" Color="#00675F" />
        <SolidColorBrush x:Key="ReviewBackground" Color="#FFF4DD" />
        <SolidColorBrush x:Key="SuggestionBackground" Color="#E6F4F0" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE6E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.83" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#0B79BF" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.44" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Teal}" />
            <Setter Property="BorderBrush" Value="{StaticResource Teal}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="#F8FAFA" />
            <Setter Property="Padding" Value="11,8" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#112E35" Padding="26,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00786C" Width="33" Height="33" CornerRadius="9" Margin="0,0,11,0">
                        <TextBlock Text="S" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ScooterScribe" FontSize="22" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Roller-hibajegyek" Foreground="#C3D8DA" Margin="15,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="FolderButton" Content="Projektmappa" HorizontalAlignment="Right"
                        Background="#24464D" BorderBrush="#557379" Foreground="White"
                        Click="ChooseFolder_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ClipToBounds="True">
            <Grid Margin="26,22,26,24" MaxWidth="1300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="#E6F4F0"
                            BorderBrush="#C6E3DC">
                        <StackPanel>
                            <TextBlock Text="Új hibajegy" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Mondd be a roller hibáját, vagy írd be kézzel."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16" />
                            <WrapPanel>
                                <Button x:Name="RecordButton" Content="Felvétel indítása"
                                        Style="{StaticResource Primary}" Click="Record_Click" Margin="0,0,8,4" />
                                <Button x:Name="AudioButton" Content="Hangfájl megnyitása"
                                        Click="OpenAudio_Click" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ProgressBar x:Name="Activity" IsIndeterminate="True" Visibility="Collapsed"
                                         Height="4" Margin="0,10,0,0" Foreground="{StaticResource Teal}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Törlés"
                                        Click="Clear_Click" />
                                <TextBlock Text="Hibajegy adatai" FontSize="21" FontWeight="Bold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <Label Content="_Hibaleírás" Target="{Binding ElementName=DescriptionBox}" />
                            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="108" VerticalScrollBarVisibility="Auto" TextChanged="Description_Changed" />
                            <TextBlock Text="Az átirat mentés előtt javítható." Foreground="{StaticResource Muted}"
                                       Margin="0,6,0,15" TextWrapping="Wrap" />
                            <Label Content="_Kategória" Target="{Binding ElementName=CategoryBox}" />
                            <TextBox x:Name="CategoryBox" MinHeight="40" TextChanged="Category_Changed" />
                            <Button x:Name="SuggestButton" Content="Kategória javaslata"
                                    HorizontalAlignment="Left" Click="Suggest_Click" Margin="0,8,0,0" />
                            <Border x:Name="RepairPanel"
                            Visibility="Collapsed"
                            Background="#E6F4F0"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Lehetséges javítás"
                                                 FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReviewNotice"
                                               Text="Ellenőrzést igényel – ez feltételes javaslat."
                                               Foreground="#805000" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,6,0,4"
                                               Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="RepairText"
                                                 Margin="0,4,0,0"
                                                 TextWrapping="Wrap" />
                                    <CheckBox x:Name="ReviewCheckBox"
                                              Margin="0,12,0,0" Visibility="Collapsed"
                                              Checked="Review_Changed" Unchecked="Review_Changed">
                                        <TextBlock Text="Ellenőriztem a leírást és a kategóriát, így mentem a hibajegyet."
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                            <Border Height="1" Background="#E4EBED" Margin="0,16,0,14" />
                            <WrapPanel>
                                <Button x:Name="SaveButton" Content="Hibajegy mentése"
                                        Style="{StaticResource Primary}" Click="Save_Click" Margin="0,0,8,4" />
                                <Button x:Name="ConfirmButton" Content="Hangos jóváhagyás"
                                        Click="Confirm_Click" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Előzmények" FontSize="21" FontWeight="Bold" />
                        <TextBlock x:Name="HistoryCount" Text="0 mentett hibajegy" Foreground="{StaticResource Muted}"
                                   Margin="0,3,0,13" />
                        <Border x:Name="HistoryEmpty" CornerRadius="10" Background="#F3F6F7" Padding="13">
                            <TextBlock Text="A mentett hibajegyek itt jelennek meg."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        </Border>
                        <ItemsControl x:Name="HistoryItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DFE8EA" BorderThickness="1" CornerRadius="10"
                                            Padding="12" Margin="0,0,0,8">
                                        <Expander Header="{Binding Kategoria}" Foreground="{StaticResource Ink}"
                                                  IsExpanded="True">
                                            <StackPanel Margin="3,7,0,0">
                                                <TextBlock Text="{Binding Hibaleiras}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LocalTime, StringFormat={}{0:yyyy.MM.dd. HH:mm}}"
                                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="OpenFolderButton" Content="Mentési mappa megnyitása"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenFolder_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE6E8" BorderThickness="0,1,0,0"
                Padding="26,11">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
